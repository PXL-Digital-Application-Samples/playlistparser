# ---------------------------------------------------------------------------
# playlistparser metadata service configuration
# Copy to .env for local development (`npm run dev` loads it automatically).
# In other environments, provide these as real environment variables.
# The service validates everything at startup and exits with a list of problems.
# ---------------------------------------------------------------------------

PORT=3001
# Listen address. Defaults to 127.0.0.1 (this machine only), because the
# service is internal. In a container, or when the API runs on another host,
# set it to 0.0.0.0 (or a private address) and keep the port off the internet.
# HOST=127.0.0.1
# LOG_LEVEL=info

# PostgreSQL connection string (required). The service has its own tables and
# migrations. It can share a server (or even a database) with the API, as long
# as it uses its own schema or database: locally it uses the "metadata" schema
# in the same database as the API.
DATABASE_URL=postgres://playlistparser:playlistparser@127.0.0.1:5432/playlistparser?schema=metadata

# Shared secret (required, min. 32 chars). The API sends it with every request;
# set the same value as METADATA_TOKEN in the API's environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METADATA_TOKEN=

# --- Last.fm (optional) -----------------------------------------------------
# Listener counts, artist tags and similar artists. Create an API account at
# https://www.last.fm/api/account/create (the callback URL can stay empty).
LASTFM_API_KEY=
# LASTFM_CACHE_DAYS=30

# Maximum request body size in MB (the API sends whole Liked Songs lists).
# BODY_LIMIT_MB=20
