# ---------------------------------------------------------------------------
# playlistparser API configuration
# Copy to .env for local development (`npm run dev` loads it automatically).
# In other environments, provide these as real environment variables.
# The API validates everything at startup and exits with a list of problems.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info

# PostgreSQL connection string (required).
DATABASE_URL=postgres://playlistparser:playlistparser@127.0.0.1:5432/playlistparser?schema=public

# --- Spotify (required) ----------------------------------------------------
# From https://developer.spotify.com/dashboard. The redirect URI must be
# registered there *exactly*, and its path must be <API_BASE_PATH>/auth/callback.
# Spotify only accepts plain http for loopback addresses (127.0.0.1), never
# for "localhost" or public hosts: anything else must be https.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# --- Secrets (required) ----------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET signs the session cookie (min. 32 chars).
# TOKEN_ENC_KEY encrypts Spotify refresh tokens at rest (exactly 64 hex chars).
SESSION_SECRET=
TOKEN_ENC_KEY=

# --- Frontend / browser ----------------------------------------------------
# Where the browser is sent after login (full URL of the frontend).
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Comma-separated origins allowed to call the API with cookies (CORS).
# Defaults to the origin of FRONTEND_ORIGIN.
# CORS_ORIGINS=http://127.0.0.1:5173

# --- Cookies ----------------------------------------------------------------
# The session cookie is sent by the browser only if these match how the
# frontend and API are hosted relative to each other.
#   COOKIE_SAMESITE: lax | strict | none   (none requires COOKIE_SECURE=true)
#   COOKIE_SECURE:   true when the API is served over https
#   COOKIE_DOMAIN:   optional, e.g. to share the cookie across subdomains
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# SESSION_TTL_DAYS=7

# --- Running behind a proxy / load balancer --------------------------------
# Serve every route (including /healthz, /readyz, /metrics) under a path
# prefix, e.g. /api. Empty = routes at the root.
# API_BASE_PATH=
# Whether to trust X-Forwarded-* headers: false | true | hop count | comma-
# separated IPs/CIDRs. Affects client IP (rate limiting) and logging.
# TRUST_PROXY=false
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_SECONDS=30

# --- Last.fm (optional) -------------------------------------------------------
# Listener counts (Spotify removed track popularity in 2026), artist tags and
# similar artists. Get a key at https://www.last.fm/api/account/create.
# Without it the app works, but those stats are missing (the UI says so).
# LASTFM_API_KEY=
# LASTFM_CACHE_DAYS=30

# Deezer (tempo) and MusicBrainz (artist origins, composers) need no
# configuration: only outbound internet access from the API.
